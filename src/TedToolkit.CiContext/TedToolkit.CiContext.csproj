<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk" />
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk" />
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk" />
  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Title>TedToolkit.CiContext</Title>
    <Description>Provider-neutral primitives for strongly typed CI process environment contexts.</Description>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TedToolkit.FileSystem" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../../.agents/skills/read-typed-ci-environment/**/*"
          Pack="true" PackagePath="skills/read-typed-ci-environment/" />
  </ItemGroup>
</Project>
